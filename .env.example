# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Only variables starting with VITE_ are exposed to the browser, so only put PUBLIC values here.

# Supabase project URL and public (anon / publishable) key.
# Dashboard -> Project Settings -> API. The anon/publishable key is safe in the browser
# because every table is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional branding overrides (defaults live in src/config/brand.ts).
VITE_APP_NAME=Kinora

# Base path the site is served from. "/" for a custom domain or local dev,
# "/<repository-name>/" for a GitHub Pages project site. The GitHub Actions workflow sets this for you.
VITE_BASE_PATH=/

# Optional upload limits shown and enforced in the browser (the server enforces its own limits too).
VITE_MAX_UPLOAD_MB=1024
VITE_MAX_VIDEO_MINUTES=10

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS: do NOT put these in .env.local and never prefix them with VITE_.
# Set them as Supabase Edge Function secrets instead (see docs/SETUP.md):
#
#   npx supabase secrets set --env-file supabase/functions/.env
#
# MUX_TOKEN_ID=your-mux-access-token-id
# MUX_TOKEN_SECRET=your-mux-access-token-secret
# MUX_SIGNING_KEY_ID=your-mux-signing-key-id
# MUX_SIGNING_KEY_PRIVATE=base64-encoded-private-key-from-mux
# MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret
# ALLOWED_ORIGINS=https://your-name.github.io,http://localhost:5173
# MUX_TEST_MODE=false
# MUX_VIDEO_QUALITY=basic
# PLAYBACK_TOKEN_TTL_SECONDS=3600
