# Edge Function secrets. Copy to supabase/functions/.env (git-ignored), fill in, then run:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Mux API access token (Mux dashboard -> Settings -> Access Tokens; permissions: Mux Video read + write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux signing key for signed playback (Mux dashboard -> Settings -> Signing Keys). Paste the base64 private key as given.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Mux webhook signing secret (Mux dashboard -> Settings -> Webhooks)
MUX_WEBHOOK_SECRET=

# Comma-separated list of site origins allowed to upload directly to Mux and call the functions
ALLOWED_ORIGINS=http://localhost:5173

# "true" creates free, watermarked, 10-second test assets that Mux deletes after 24 hours
MUX_TEST_MODE=false

# "basic" (no encoding cost) or "plus"
MUX_VIDEO_QUALITY=basic

# How long signed playback and thumbnail links stay valid
PLAYBACK_TOKEN_TTL_SECONDS=3600
